# wechat-ingest.path - trigger the inbox consumer when files land in inbox/
#
# Path units never open a TCP listener; they only watch inotify on the path
# below (plan guardrail: "Do not add ... a new public port.  Ingest uses the
# existing SSH.  18790 stays localhost-only.").

[Unit]
Description=Watch wechat-ingest inbox for new events

[Path]
# The plugin SFTP-drops inbox/<uuid>.json here; any change (new file or
# reopened for appending media) fires the consumer once per burst.
PathChanged=/root/.openclaw/wechat-ingest/inbox/
Unit=wechat-ingest.service
MakeDirectory=yes
DirectoryMode=0755

[Install]
WantedBy=multi-user.target
